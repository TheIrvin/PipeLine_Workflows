N8N_VERSION=2.40.7
N8N_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
TZ=America/Guayaquil
IDEA_MIN_PENDING=30
IDEA_BATCH_SIZE=30
IDEA_API_PORT=8090

# manual-inbox: espera medios generados manualmente; mock: imágenes de prueba locales
MEDIA_PROVIDER=manual-inbox

CONTENT_BUFFER_MIN=7
CONTENT_BUFFER_TARGET=14
# Guionista local (Ollama). Se descarga al iniciar el stack.
NARRATION_MODEL=qwen3:4b

# Fish Audio sintetiza la voz y requiere una clave privada en este archivo local.
TTS_PROVIDER=fish-audio
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=1f7fb4bc1697479aab869ff685bfa644
FISH_AUDIO_MODEL=s2.1-pro-free
TTS_VOICE=es-la
TTS_SPEED=170
