N8N_VERSION=2.40.7
N8N_ENCRYPTION_KEY=replace-with-a-random-64-character-hex-key
TZ=America/Guayaquil
PIPELINE_UID=1000
PIPELINE_GID=1000
IDEA_MIN_PENDING=30
IDEA_BATCH_SIZE=30
IDEA_API_PORT=8090

# manual-inbox: espera medios generados manualmente; mock: imágenes de prueba locales
MEDIA_PROVIDER=manual-inbox
# Host folder mounted into the worker. Relative paths resolve from this repository.
# Default creates ./videos/{subir,terminado}; an absolute path can be used if preferred.
MEDIA_INBOX_HOST_PATH=./videos

CONTENT_BUFFER_MIN=7
CONTENT_BUFFER_TARGET=14
# Guionista local (Ollama). Se descarga al iniciar el stack.
NARRATION_MODEL=qwen3:4b

# Síntesis y clonación local; no requiere API key.
TTS_PROVIDER=qwen3-tts-local
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Añade tu muestra y transcripción localmente en data/models/voice-reference/.
QWEN_TTS_REFERENCE_AUDIO=/app/data/models/voice-reference/Audio_Ejemplo.mp3
QWEN_TTS_REFERENCE_TEXT_FILE=/app/data/models/voice-reference/Audio_Ejemplo.txt
TTS_VOICE=es-la
TTS_SPEED=170
